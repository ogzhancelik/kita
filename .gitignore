# =============================================================================
# Kita Game Backend - .gitignore
# =============================================================================

# Large Databases and Solvers (MUST NOT BE PUSHED TO GITHUB)
kita_solver.db
*.db
*.sqlite
*.sqlite3

# Solver module & CLI (Heavy retrograde analysis, not needed for game backend)
solver/
solver_cli.py
tests/test_solver_sqlite.py
export_first_4_layers.py

# Temporary scripts, simulations and analysis notes
scratch/
new_starting_state_analysis.md
state_*.md

# Python cache & build files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/

# IDE and Editor configs
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# AI / IDE metadata
.gemini/
.agents/
